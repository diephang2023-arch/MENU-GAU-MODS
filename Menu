-- Hiệu ứng bấm nút siêu mượt
local function playButtonEffect(btn, originalColor)
    local activeColor = Color3.fromRGB(0, 170, 255)
    pcall(function()
        btn.MouseButton1Click:Connect(function()
            local originalSize = btn.Size
            TweenService:Create(btn, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(originalSize.X.Scale, originalSize.X.Offset - 4, originalSize.Y.Scale, originalSize.Y.Offset - 2),
                BackgroundColor3 = activeColor
            }):Play()
            task.delay(0.12, function()
                TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Size = originalSize,
                    BackgroundColor3 = originalColor
                }):Play()
            end)
        end)
    end)
end

