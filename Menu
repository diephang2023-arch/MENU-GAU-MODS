-- LƯU DỮ LIỆU
local savedScripts = {}
local SAVE_FILE_NAME = "GauMods_SavedScripts.json"

local function saveToDisk()
    if writefile then pcall(function() writefile(SAVE_FILE_NAME, HttpService:JSONEncode(savedScripts)) end) end
end

local function loadFromDisk()
    if readfile and isfile and isfile(SAVE_FILE_NAME) then
        local success, data = pcall(function() return HttpService:JSONDecode(readfile(SAVE_FILE_NAME)) end)
        if success and type(data) == "table" then savedScripts = data end
    end
end
loadFromDisk()

