-- Vòng lặp Auto Steal ngầm (Ưu tiên lấy các thẻ được đẩy lên đầu tiên)
task.spawn(function()
    while true do
        if isAutoStealing then
            local activeCards = {}
            for _, child in ipairs(scrollFrame:GetChildren()) do
                if child:IsA("Frame") then
                    table.insert(activeCards, child)
                end
            end
            table.sort(activeCards, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
            
            for _, card in ipairs(activeCards) do
                if not isAutoStealing then break end
                for _, item in ipairs(eggCardItems) do
                    if item.getCard() == card and item.data.part and item.data.part.Parent then
                        executeSteal(item.data)
                        task.wait(0.3)
                        break
                    end
                end
            end
        end
        task.wait(0.5)
    end
end)

