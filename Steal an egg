-- Hàm định dạng tiền dạng số thuần túy + /s
local function formatMoney(amount)
    if amount >= 1e15 then return string.format("%.1fQa/s", amount/1e15)
    elseif amount >= 1e12 then return string.format("%.1fT/s", amount/1e12)
    elseif amount >= 1e9 then return string.format("%.1fB/s", amount/1e9)
    elseif amount >= 1e6 then return string.format("%.1fM/s", amount/1e6)
    elseif amount >= 1e3 then return string.format("%.1fk/s", amount/1e3)
    else return string.format("%d/s", amount) end
end

local function executeSteal(eggData)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp and eggData.part and eggData.part.Parent then
        local oldCFrame = hrp.CFrame
        
        if antiBanEnabled then
            task.wait(math.random(50, 120) / 1000)
        end
        
        hrp.CFrame = eggData.part.CFrame + Vector3.new(0, 3, 0)
        task.wait(0.1)
        
        pcall(function()
            firetouchinterest(hrp, eggData.part, 0)
            firetouchinterest(hrp, eggData.part, 1)
        end)
        
        local tweenInfo = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tween = TweenService:Create(hrp, tweenInfo, {CFrame = oldCFrame})
        tween:Play()
    end
end

