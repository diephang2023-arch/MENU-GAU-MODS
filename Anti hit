-- Hiệu ứng chuyển đổi Bật / Tắt
local function setToggleState(enabled)
    State.AntiGuard = enabled
    local info = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    if enabled then
        -- Màu cam đỏ nổi bật giống trong ảnh khi BẬT
        TweenService:Create(SwitchTrack, info, {BackgroundColor3 = Color3.fromRGB(235, 95, 55)}):Play()
        TweenService:Create(SwitchKnob, info, {Position = UDim2.new(1, -19, 0.5, 0)}):Play()
        TweenService:Create(CardStroke, info, {Color = Color3.fromRGB(235, 95, 55), Transparency = 0.1}):Play()
    else
        TweenService:Create(SwitchTrack, info, {BackgroundColor3 = Color3.fromRGB(68, 65, 60)}):Play()
        TweenService:Create(SwitchKnob, info, {Position = UDim2.new(0, 3, 0.5, 0)}):Play()
        TweenService:Create(CardStroke, info, {Color = Color3.fromRGB(85, 78, 65), Transparency = 0.35}):Play()
    end
end

SwitchTrack.Activated:Connect(function()
    setToggleState(not State.AntiGuard)
end)

-- Kéo thả toàn bộ thanh widget (hỗ trợ cả cảm ứng và chuột)
local dragging = false
local dragInput = nil
local dragStart = nil
local startPos = nil

MainCard.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainCard.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

MainCard.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainCard.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

-- Logic kích hoạt Anti Guard khi chạm ProximityPrompt
local isExecuting = false
ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
    if player ~= LocalPlayer then return end
    if not State.AntiGuard or isExecuting then return end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    isExecuting = true
    for _, pos in ipairs(TeleportPoints) do
        if not State.AntiGuard or not root.Parent then
            break
        end
        root.CFrame = CFrame.new(pos)
        task.wait(State.RouteSpeed)
    end
    isExecuting = false
end)

