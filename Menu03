local isSending = false
local function sendGlobalMessage()
    if isSending then return end
    local text = chatTextBox.Text:gsub("^%s*(.-)%s*$", "%1")
    if text ~= "" then
        isSending = true
        local nameToSend = (myChatName ~= "" and myChatName) or player.Name
        chatTextBox.Text = ""
        
        table.insert(chatHistory, {sender = nameToSend, msg = text})
        saveChatHistoryToDisk()
        appendChatMessage(nameToSend, text)
        
        pcall(function()
            local ev = playerGui:FindFirstChild(chatRemoteName)
            if ev then ev:Fire(nameToSend, text) end
        end)
        
        task.delay(0.3, function() isSending = false end)
    end
end

