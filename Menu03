    local pos = math.clamp((input.Position.X - opacityBar.AbsolutePosition.X) / opacityBar.AbsoluteSize.X, 0, 1)
    opacityFill.Size = UDim2.new(pos, 0, 1, 0)
    local alpha = 0.05 + (pos * 0.5)
    mainFrame.BackgroundTransparency = alpha
    opacitySliderBtn.Text = string.format("Độ mờ: %d%%", math.floor(pos * 100))
end

