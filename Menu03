local CHAT_NAME_FILE = "GauMods_ChatName.json"
local myChatName = ""

local function loadChatName()
    if readfile and isfile and isfile(CHAT_NAME_FILE) then
        local success, data = pcall(function() return HttpService:JSONDecode(readfile(CHAT_NAME_FILE)) end)
        if success and type(data) == "table" and data.name then
            myChatName = data.name
        end
    end
end
loadChatName()

local function saveChatName(name)
    myChatName = name
    if writefile then
        pcall(function()
            writefile(CHAT_NAME_FILE, HttpService:JSONEncode({name = name}))
        end)
    end
end

