local function playSoundByID(id)
    local cleanID = tostring(id):gsub("%D", "")
    if cleanID ~= "" then
        currentSound:Stop()
        currentSound.SoundId = "rbxassetid://" .. cleanID
        currentSound:Play()
        isDiscSpinning = true
        musicInputBox.Text = cleanID
    end
end
