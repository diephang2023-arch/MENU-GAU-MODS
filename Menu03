local function playButtonEffect(btn, originalColor)
    local activeColor = Color3.fromRGB(50, 150, 255)
    btn.MouseButton1Click:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = activeColor}):Play()
        task.delay(0.25, function()
            TweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = originalColor}):Play()
        end)
    end)
end

local function copyToClipboard(text)
    if setclipboard then
        pcall(function() setclipboard(text) end)
    elseif syn and syn.write_clipboard then
        pcall(function() syn.write_clipboard(text) end)
    end
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "Thành công",
            Text = "Đã sao chép nội dung vào bộ nhớ tạm!",
            Duration = 2
        })
    end)
end

