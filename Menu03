-- Hiệu ứng đổi màu nút khi bấm (Sáng xanh nước biển nhạt 0.3s rồi hồi lại màu cũ)
local function playButtonEffect(btn, originalColor, hoverColor)
    local activeColor = Color3.fromRGB(100, 200, 255) -- Xanh nước biển nhạt
    btn.MouseButton1Click:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = activeColor}):Play()
        task.delay(0.3, function()
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = originalColor}):Play()
        end)
    end)
end

