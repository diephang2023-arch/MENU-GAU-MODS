    if remote and remote:IsA("RemoteFunction") then
        local ok, r1, r2, r3 = pcall(function(...) return remote:InvokeServer(...) end, ...)
        if ok then return true, r1, r2, r3 end
        return false, r1
    end
    return false, "RemoteFunction not found: " .. tostring(pathName)
