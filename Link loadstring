local function handleStealCycle()
    if State.isStealingActive then return end
    State.isStealingActive = true
    State.currentStealSession = State.currentStealSession + 1
    local sessionId = State.currentStealSession

    if not PriorityManager:Acquire("Auto Steal", 25.0) then
        State.isStealingActive = false
        return
    end

    local records = getFieldEggRecords()
    local targetRecord = nil
    local targetUid = nil

    if State.targetedSpecificUid then
        targetUid = State.targetedSpecificUid
        targetRecord = records[targetUid]
    else
        local minScore = getMinRequiredScore()
        local bestVal = -1
        for kUid, rec in pairs(records) do
            if type(rec) == "table" then
                local uid = rec.Uid or kUid
                if not isBlacklisted(uid) and matchesTargetArea(rec.AreaId) then
                    local rName = rec.AssetCategory or "Unknown"
                    local _, rRank = MasterRegistry:Lookup(rName)
                    if rRank >= minScore then
                        local val = tonumber(rec.Value) or tonumber(rec.MoneyPerSec) or 1
                        if val > bestVal then
                            bestVal = val
                            targetRecord = rec
                            targetUid = uid
                        end
                    end
                end
            end
        end
    end

    if not targetUid or not targetRecord then
        PriorityManager:Release("Auto Steal")
        State.isStealingActive = false
        return
    end

    StealUIManager:SnapshotNormalHUD()
    StealUIManager:Lock()
    ShieldManager:MuteUGI()
    ShieldManager:ApplyHumanoidSwap(LocalPlayer.Character)

    local targetPos = targetRecord.Position or (targetRecord.Record and targetRecord.Record.Position)
    if not targetPos then
        local eggModel = Services.Workspace:FindFirstChild(targetUid)
        if eggModel then targetPos = eggModel:GetPivot().Position end
    end

    if targetPos then
        local reached = runAlongGroundToEgg(targetPos, 32, sessionId, targetUid)
        if reached and sessionId == State.currentStealSession then
            instantGrabAtPosition(targetUid, targetPos, sessionId, false)
            if isHoldingEgg() then
                executeCheckpointedHopsHome(targetRecord, sessionId)
            else
                blacklistEgg(targetUid, 15)
            end
        end
    end

    if State.targetedSpecificUid then
        State.targetedSpecificUid = nil
    end

    ShieldManager:UnmuteUGI()
    ShieldManager:UndoSwap()
    StealUIManager:Unlock()
    PriorityManager:Release("Auto Steal")
    State.isStealingActive = false
end

